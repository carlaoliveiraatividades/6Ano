rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacher() {
      return isAuthenticated() && request.auth.token.role == 'teacher';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // Public Educational Content (Read-only for all, write restricted to admin)
    match /worlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /simulators/{simulatorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weeklyChallenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyTips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dailyQuotes/{quoteId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classes and Class Members
    match /classes/{classId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /classMembers/{memberId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      // Clients cannot change their own role, XP, or level directly
      allow write: if false; 
    }

    // Student Progress
    match /studentProgress/{progressId} {
      allow read: if true;
      // Sensitive progress updates MUST go through server-side APIs
      allow write: if false;
    }

    // Assessment Attempts & Results (Server-verified only)
    match /assessmentAttempts/{attemptId} {
      allow read: if true;
      allow write: if false; // Only server writes official attempts
    }

    // XP Transactions (Audit trail, Server-only write)
    match /xpTransactions/{txId} {
      allow read: if true;
      allow write: if false; // Clients cannot create XP transactions
    }

    // Badges earned by students
    match /studentBadges/{sbId} {
      allow read: if true;
      allow write: if false; // Server-only awarded
    }

    // Real Missions Submissions
    match /missions/{missionId} {
      allow read: if true;
      allow write: if false; // Submissions are processed through server
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if false; // Append-only by server
    }
  }
}

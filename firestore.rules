rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // PLATAFORMA EDUCATIVA MISSÃO TIC - 6.º ANO
    // MODELO DE SEGURANÇA: SERVER-AUTHORITATIVE ARCHITECTURE
    //
    // A aplicação utiliza autenticação de sessão e autorização server-side (Node/Express).
    // O cliente NUNCA escreve ou lê diretamente no Firestore.
    // Todas as operações sensíveis, de gamificação, avaliação e credenciais
    // são autorizadas e executadas exclusivamente pelo backend.
    // -------------------------------------------------------------------------

    // Bloqueio preventivo global por omissão
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. CREDENCIAIS SEGURAS (Hashes e Salts de Palavras-passe)
    // CRÍTICO: Bloqueio absoluto contra qualquer acesso direto de leitura ou escrita pelo cliente.
    // Apenas o backend acede a esta coleção para autenticação criptográfica.
    match /userCredentials/{credentialId} {
      allow read, write: if false;
    }

    // 2. UTILIZADORES (Perfis de Alunos e Professores)
    // Protegido contra escrita direta (impede alteração de roles, criação de teachers ou injeção de XP).
    // Acesso mediado exclusivamente via rotas /api/users, /api/auth e /api/ranking.
    match /users/{userId} {
      allow read, write: if false;
    }

    // 3. PROGRESSO DO ALUNO (Módulos, Mundos, Desafios)
    // Protegido contra manipulação direta de progresso curricular.
    match /studentProgress/{userId} {
      allow read, write: if false;
    }

    // 4. TRANSAÇÕES DE XP (Gamificação Server-Authoritative)
    // Histórico de mérito gerado apenas pelo servidor com XP canónico.
    match /xpTransactions/{transactionId} {
      allow read, write: if false;
    }

    // 5. TENTATIVAS DE AVALIAÇÃO SUMATIVA
    // Submissões corrigidas e classificadas apenas no servidor.
    match /assessmentAttempts/{attemptId} {
      allow read, write: if false;
    }

    // 6. MEDALHAS E INSÍGNIAS DE ALUNOS
    // Atribuição de medalhas controlada pelo backend / professora.
    match /studentBadges/{badgeId} {
      allow read, write: if false;
    }

    // 7. AUDITORIA E REGISTO DE EVENTOS (Audit Logs)
    // Logs de segurança e rastreabilidade imutáveis gerados pelo servidor.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // 8. TURMAS E ASSOCIAÇÕES DE ALUNOS (Classes & ClassMembers)
    // Gestão de turmas e isolamento curricular gerido pelo professor via API.
    match /classes/{classId} {
      allow read, write: if false;
    }

    match /classMembers/{memberId} {
      allow read, write: if false;
    }

    // 9. SUBMISSÕES DE TRABALHOS PRÁTICOS (Missions)
    // Submissões de alunos e avaliações/feedback da professora geridos via API.
    match /missions/{missionId} {
      allow read, write: if false;
    }

    // 10. CONTEÚDO CURRICULAR E CATÁLOGOS (Mundos, Badges, Desafios, Dicas)
    // Conteúdo gerido e distribuído pelo servidor da plataforma.
    match /worlds/{worldId} {
      allow read, write: if false;
    }

    match /badges/{badgeId} {
      allow read, write: if false;
    }

    match /weeklyChallenges/{challengeId} {
      allow read, write: if false;
    }

    match /dailyTips/{tipId} {
      allow read, write: if false;
    }

    match /dailyQuotes/{quoteId} {
      allow read, write: if false;
    }
  }
}
